{
  "name": "riot-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Riot Control — isometric pixel-art horde tower-defense parody",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node tools/shoot.mjs",
    "gallery": "vite --open /gallery.html",
    "sprites": "node tools/export-sprites.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
